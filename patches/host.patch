@@ -313,6 +313,39 @@ namespace SubCraft.Link
 			I64Release(o + Proto.IrHead, inputHead);
 		}
 
+		// ---- command box (produce): host -> MC debug commands, mirrors tools/mc_cmd.py ----
+		//
+		// Added for the item bridge (thatg's PC, 2026-10-09). The guest polls this box and runs the
+		// text as a Minecraft command (text starting with "/") or a SubCraft command ("subcraft ...").
+		// One command in flight at a time: seq is bumped, the guest acks with the same value.
+		private uint commandSeq;
+
+		public bool CommandIdle => commandSeq == 0 || U32(Proto.OffCommandBox + Proto.CbAck) == commandSeq;
+
+		public uint LastCommandSeq => commandSeq;
+
+		/// <summary>Queues one command for Minecraft. Returns false while the previous one is unacked
+		/// (or the text is too long); the caller retries on a later frame.</summary>
+		public bool PushCommand(string text)
+		{
+			if (text == null) return false;
+			long o = Proto.OffCommandBox;
+			uint ack = U32(o + Proto.CbAck);
+			if (commandSeq != 0 && ack != commandSeq) return false;   // previous still running
+			byte[] bytes = Encoding.UTF8.GetBytes(text);
+			if (bytes.Length > Proto.CommandTextBytes) return false;
+			fixed (byte* src = bytes)
+			{
+				byte* dst = b + o + Proto.CbText;
+				for (int i = 0; i < bytes.Length; i++) dst[i] = src[i];
+				dst[bytes.Length] = 0;
+			}
+			Put(o + Proto.CbTextLen, (uint)bytes.Length);
+			commandSeq = ack + 1;
+			Put(o + Proto.CbSeq, commandSeq);
+			return true;
+		}
+
 		// ---- event ring (consume) ----
 
 		public struct McEvent
