index 0000000..aabc8cf
--- /dev/null
+++ b/host-subnautica/src/World/WorldAnchor.cs
@@ -0,0 +1,69 @@
+using SubCraft.Link;
+using UnityEngine;
+
+namespace SubCraft.World
+{
+	/// <summary>
+	/// Anchors Minecraft's spawn to Subnautica's own spawn point (the lifepod), so dying and respawning
+	/// in Minecraft never drops the player into the void below the world.
+	///
+	/// Requested by the player 2026-10-09: the dev world's default spawn sits under the water column
+	/// (the world spans y = -2032..255), so the Minecraft player respawned at the bottom and died of
+	/// "outOfWorld" over and over. Subnautica already knows where a player starts, so we read it and
+	/// hand it to Minecraft through the link's command box.
+	/// </summary>
+	public static class WorldAnchor
+	{
+		private static bool sent;
+
+		public static void Reset()
+		{
+			sent = false;
+		}
+
+		public static void Frame(bool inGame)
+		{
+			if (sent || !inGame)
+			{
+				return;
+			}
+			Vector3 spawn;
+			if (!TrySpawn(out spawn))
+			{
+				return;
+			}
+			int x = Mathf.FloorToInt(spawn.x);
+			int y = Mathf.FloorToInt(spawn.y) + 1;   // stand on the floor, not in it
+			int z = Mathf.FloorToInt(-spawn.z);      // Unity -> Minecraft: z is mirrored
+			GuestCommands.Enqueue("/setworldspawn " + x + " " + y + " " + z);
+			GuestCommands.Enqueue("/spawnpoint @s " + x + " " + y + " " + z);
+			sent = true;
+			Plugin.Log.LogInfo("SubCraft spawn: Minecraft spawn anchored at Subnautica's (" + x + ", " + y + ", " + z + ")");
+		}
+
+		private static bool TrySpawn(out Vector3 position)
+		{
+			position = Vector3.zero;
+			try
+			{
+				EscapePod pod = EscapePod.main;
+				if (pod != null && pod.playerSpawn != null)
+				{
+					position = pod.playerSpawn.position;
+					return true;
+				}
+				global::Player player = global::Player.main;
+				if (player != null && player.transform != null)
+				{
+					position = player.transform.position;
+					return true;
+				}
+			}
+			catch (System.Exception e)
+			{
+				Plugin.Log.LogWarning("SubCraft spawn: cannot read Subnautica's spawn point: " + e.Message);
+			}
+			return false;
+		}
+	}
+}
