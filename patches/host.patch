diff --git a/host-subnautica/src/Items/ItemBridge.cs b/host-subnautica/src/Items/ItemBridge.cs
new file mode 100644
index 0000000..ade4da2
--- /dev/null
+++ b/host-subnautica/src/Items/ItemBridge.cs
@@ -0,0 +1,219 @@
+using System;
+using System.Collections.Generic;
+using System.Text;
+using SubCraft.Link;
+using UnityEngine;
+
+namespace SubCraft.Items
+{
+	/// <summary>
+	/// Subnautica -> Minecraft item bridge (MISSION.md Phase 6, first slice).
+	///
+	/// Subnautica owns pickups, so a fish you catch lives in Subnautica's inventory and Minecraft's
+	/// never sees it. While linked this watches Subnautica's inventory and, for every item gained,
+	/// asks the guest to hand over the matching Minecraft item through the link's command box:
+	///
+	///     /give @s subcraft:subnautica_item[subcraft:tech_type="Peeper",subcraft:label="眼鱼"] 2
+	///
+	/// Items already in the inventory when the link comes up are NOT granted (a fresh session would
+	/// otherwise dump the whole back catalogue into Minecraft); the harness command "itemsync" does
+	/// that on demand.
+	///
+	/// v1 is a copy, not a move: the Subnautica item stays where it was, so the two inventories can
+	/// show the same pickaxe. Turn that into a move once a Minecraft -> Subnautica path exists
+	/// (fabricator direction is still an open question in MISSION.md section 9.3).
+	/// </summary>
+	public static class ItemBridge
+	{
+		private const float PollSeconds = 0.5f;
+
+		private static readonly Dictionary<string, TechType> kinds = new Dictionary<string, TechType>();
+		private static readonly Dictionary<string, int> now = new Dictionary<string, int>();
+		private static readonly Dictionary<string, int> last = new Dictionary<string, int>();
+		private static float nextPoll;
+		private static bool primed;
+
+		/// <summary>Commands actually handed to Minecraft this session (harness/status reads it).</summary>
+		public static int GrantedTotal { get; private set; }
+		public static string LastGrant { get; private set; }
+
+		public static void Reset()
+		{
+			kinds.Clear();
+			now.Clear();
+			last.Clear();
+			primed = false;
+		}
+
+		/// <summary>Called once per host frame. Cheap when nothing changed: a dictionary walk every 0.5 s.</summary>
+		public static void Frame(LinkView view, bool inGame)
+		{
+			if (view == null)
+			{
+				return;
+			}
+			if (!inGame)
+			{
+				if (primed)
+				{
+					Reset();
+				}
+				return;
+			}
+
+			float nowSeconds = Time.realtimeSinceStartup;
+			if (nowSeconds < nextPoll)
+			{
+				return;
+			}
+			nextPoll = nowSeconds + PollSeconds;
+
+			Snapshot();
+			if (!primed)
+			{
+				primed = true;
+				Copy(now, last);
+				Plugin.Log.LogInfo("SubCraft items: watching " + now.Count + " kind(s) already in the inventory");
+				return;
+			}
+			foreach (var kv in now)
+			{
+				int before;
+				last.TryGetValue(kv.Key, out before);
+				if (kv.Value > before)
+				{
+					Enqueue(kv.Key, kv.Value - before);
+				}
+			}
+			Copy(now, last);
+		}
+
+		/// <summary>Harness "itemsync": grant everything currently in Subnautica's inventory.</summary>
+		public static int SyncAll(LinkView view)
+		{
+			if (view == null)
+			{
+				return 0;
+			}
+			Snapshot();
+			int n = 0;
+			foreach (var kv in now)
+			{
+				Enqueue(kv.Key, kv.Value);
+				n += kv.Value;
+			}
+			Copy(now, last);
+			primed = true;
+			Plugin.Log.LogInfo("SubCraft items: itemsync queued " + Link.GuestCommands.Queued + " command(s) for " + n + " item(s)");
+			return n;
+		}
+
+		// ---- internals -------------------------------------------------------------------------
+
+		private static void Snapshot()
+		{
+			now.Clear();
+			Inventory inv = Inventory.main;
+			if (inv == null)
+			{
+				return;
+			}
+			ItemsContainer container = inv.container;
+			if (container == null)
+			{
+				return;
+			}
+			foreach (InventoryItem item in container)
+			{
+				if (item == null)
+				{
+					continue;
+				}
+				TechType tech = item.techType;
+				string key = Name(tech);
+				if (!kinds.ContainsKey(key))
+				{
+					kinds[key] = tech;
+				}
+				if (!now.ContainsKey(key))
+				{
+					// GetPickupCount sees stacked items; the container walk only gives kinds.
+					now[key] = inv.GetPickupCount(tech);
+				}
+			}
+		}
+
+		private static void Enqueue(string key, int count)
+		{
+			if (count <= 0)
+			{
+				return;
+			}
+			TechType tech;
+			if (!kinds.TryGetValue(key, out tech))
+			{
+				return;
+			}
+			string label = key;
+			try
+			{
+				string localized = Language.main != null ? Language.main.Get(key) : null;
+				if (!string.IsNullOrEmpty(localized))
+				{
+					label = localized;
+				}
+			}
+			catch (Exception e)
+			{
+				Plugin.Log.LogWarning("SubCraft items: no localized name for " + key + ": " + e.Message);
+			}
+			// minecraft:custom_data needs no registration on the guest side and survives saving and
+			// syncing, so one item id carries every TechType (see guest SubnauticaItem).
+			string cmd = "/give @s subcraft:subnautica_item[minecraft:custom_data={subcraft_tech:\"" + Clean(key) +
+				"\",subcraft_label:\"" + Clean(label) + "\"}] " + count;
+			Link.GuestCommands.Enqueue(cmd);
+			GrantedTotal++;
+			LastGrant = cmd;
+		}
+
+		private static string Name(TechType tech)
+		{
+			try
+			{
+				return TechTypeExtensions.AsString(tech, false);
+			}
+			catch (Exception)
+			{
+				return tech.ToString();
+			}
+		}
+
+		/// <summary>Keeps the text inside one command argument: no quotes, backslashes or control chars.</summary>
+		private static string Clean(string s)
+		{
+			if (string.IsNullOrEmpty(s))
+			{
+				return "?";
+			}
+			StringBuilder sb = new StringBuilder(s.Length);
+			foreach (char c in s)
+			{
+				if (c == '"' || c == '\\' || c < ' ')
+				{
+					continue;
+				}
+				sb.Append(c);
+			}
+			return sb.Length == 0 ? "?" : sb.ToString();
+		}
+
+		private static void Copy(Dictionary<string, int> from, Dictionary<string, int> to)
+		{
+			to.Clear();
+			foreach (var kv in from)
+			{
+				to[kv.Key] = kv.Value;
+			}
+		}
+	}
+}
diff --git a/host-subnautica/src/Link/GuestCommands.cs b/host-subnautica/src/Link/GuestCommands.cs
new file mode 100644
index 0000000..cc6da66
--- /dev/null
+++ b/host-subnautica/src/Link/GuestCommands.cs
@@ -0,0 +1,67 @@
+using System.Collections.Generic;
+using SubCraft.Link;
+
+namespace SubCraft.Link
+{
+	/// <summary>
+	/// One queue for host -> Minecraft commands (protocol command box, v12). Several host systems want
+	/// to send commands (the item bridge, the spawn anchor, ...) but the box has a single slot and the
+	/// guest acks one at a time, so they all enqueue here and <see cref="Frame"/> pushes the next one.
+	///
+	/// Added 2026-10-09 (thatg's PC) with the item bridge; previously nothing on the host wrote the box.
+	/// </summary>
+	public static class GuestCommands
+	{
+		private static readonly Queue<string> waiting = new Queue<string>();
+		private static string inFlight;
+
+		public static int Queued => waiting.Count + (inFlight != null ? 1 : 0);
+
+		public static void Enqueue(string command)
+		{
+			if (string.IsNullOrEmpty(command))
+			{
+				return;
+			}
+			waiting.Enqueue(command);
+		}
+
+		public static void Reset()
+		{
+			waiting.Clear();
+			inFlight = null;
+		}
+
+		/// <summary>Pushes at most one command per frame; retries while the box is busy.</summary>
+		public static void Frame(LinkView view, bool linked)
+		{
+			if (view == null || !linked)
+			{
+				if (!linked)
+				{
+					Reset();
+				}
+				return;
+			}
+			if (inFlight != null)
+			{
+				if (!view.CommandIdle)
+				{
+					return;
+				}
+				inFlight = null;
+			}
+			if (waiting.Count == 0)
+			{
+				return;
+			}
+			string cmd = waiting.Peek();
+			if (view.PushCommand(cmd))
+			{
+				waiting.Dequeue();
+				inFlight = cmd;
+				Plugin.Log.LogInfo("SubCraft command -> Minecraft: " + cmd);
+			}
+		}
+	}
+}
