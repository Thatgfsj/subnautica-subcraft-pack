index 0000000..6dccfa4
--- /dev/null
+++ b/guest-neoforge/src/main/java/dev/subcraft/items/SubnauticaItem.java
@@ -0,0 +1,58 @@
+package dev.subcraft.items;
+
+import java.util.List;
+import net.minecraft.ChatFormatting;
+import net.minecraft.core.component.DataComponents;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.network.chat.Component;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.item.TooltipFlag;
+import net.minecraft.world.item.component.CustomData;
+
+/**
+ * A Subnautica item, as Minecraft sees it: one item id, the TechType and its localized name in
+ * {@code minecraft:custom_data} (written by the host through the link's command box).
+ */
+public class SubnauticaItem extends Item {
+	/** Keys inside minecraft:custom_data; the host writes them. */
+	public static final String TECH_KEY = "subcraft_tech";
+	public static final String LABEL_KEY = "subcraft_label";
+
+	public SubnauticaItem(Properties properties) {
+		super(properties);
+	}
+
+	@Override
+	public Component getName(ItemStack stack) {
+		CompoundTag tag = data(stack);
+		if (tag != null) {
+			String label = tag.getString(LABEL_KEY);
+			if (!label.isEmpty()) {
+				return Component.literal(label);
+			}
+			String tech = tag.getString(TECH_KEY);
+			if (!tech.isEmpty()) {
+				return Component.literal(tech);
+			}
+		}
+		return super.getName(stack);
+	}
+
+	@Override
+	public void appendHoverText(ItemStack stack, TooltipContext context, List<Component> tooltip, TooltipFlag flag) {
+		CompoundTag tag = data(stack);
+		if (tag == null) {
+			return;
+		}
+		String tech = tag.getString(TECH_KEY);
+		if (!tech.isEmpty()) {
+			tooltip.add(Component.literal(tech).withStyle(ChatFormatting.DARK_GRAY));
+		}
+	}
+
+	private static CompoundTag data(ItemStack stack) {
+		CustomData custom = stack.get(DataComponents.CUSTOM_DATA);
+		return custom == null ? null : custom.copyTag();
+	}
+}
