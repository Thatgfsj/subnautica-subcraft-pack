@@ -0,0 +1,31 @@
+package dev.subcraft.items;
+
+import dev.subcraft.SubCraft;
+import net.minecraft.world.item.Item;
+import net.neoforged.bus.api.IEventBus;
+import net.neoforged.neoforge.registries.DeferredItem;
+import net.neoforged.neoforge.registries.DeferredRegister;
+
+/**
+ * The item bridge's Minecraft side (MISSION.md Phase 6, first slice).
+ *
+ * Subnautica owns pickups, so one Minecraft item stands in for every Subnautica TechType instead of
+ * one registered item per type (Minecraft registers items at mod construction, long before the host
+ * tells us which TechTypes exist). The type and its localized name ride along in
+ * {@code minecraft:custom_data}, which needs no registration and survives saving and syncing:
+ *
+ * <pre>/give @s subcraft:subnautica_item[minecraft:custom_data={subcraft_tech:"Peeper",subcraft_label:"眼鱼"}] 2</pre>
+ */
+public final class SubItems {
+	private static final DeferredRegister.Items ITEMS = DeferredRegister.createItems(SubCraft.MOD_ID);
+
+	public static final DeferredItem<SubnauticaItem> SUBNAUTICA_ITEM =
+		ITEMS.register("subnautica_item", () -> new SubnauticaItem(new Item.Properties()));
+
+	private SubItems() {
+	}
+
+	public static void register(IEventBus modBus) {
+		ITEMS.register(modBus);
+	}
+}
diff --git a/guest-neoforge/src/main/java/dev/subcraft/items/SubnauticaItem.java b/guest-neoforge/src/main/java/dev/subcraft/items/SubnauticaItem.java
